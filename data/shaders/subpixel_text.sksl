uniform half4 color;
half4 main(half4 src, half4 dst)
{
    half3 m = src.rgb * color.a;
    half average = (src.r + src.g + src.b) / 3 * color.a;
    return half4(color.rgb * m + dst.rgb * (1 - m), average + dst.a * (1 - average));
}
